<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup: settings and the database (playlists, history). Never the covers cache nor the passwords
     (they are encrypted with a key that stays on this phone, so they would be useless elsewhere). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
